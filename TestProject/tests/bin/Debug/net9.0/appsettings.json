{
    "Database": {
        "ConnectionString": ""
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/debug.log.json",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter",
                    "rollingInterval": "Day"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/debug.log",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": [
            "FromLogContext"
        ]
    }
}