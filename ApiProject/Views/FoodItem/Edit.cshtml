@model calcalc.ViewModels.FoodItemEditViewmodel
@using calcalc.Repositories;
@using calcalc.ViewModels

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit @Model.Name</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <div id="info" data-model-id="@Model.Id"></div>
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ReturnUrl" />
            @if (!Model.UserAdded)
            {
                <div>This item is added from an external source. Some data cannot be edited</div>
            }
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" readonly="@(!Model.UserAdded)" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Calories" class="control-label"></label>
                <input asp-for="Calories" class="form-control" readonly="@(!Model.UserAdded)" />
                <span asp-validation-for="Calories" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SynonymsCommaseparated" class="control-label"></label>
                <input asp-for="SynonymsCommaseparated" class="form-control" />
                <span asp-validation-for="SynonymsCommaseparated" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>

            @if (Model?.UpdateResult?.Error != null)
            {
                <div role="alert">
                    @switch (Model?.UpdateResult?.Error)
                    {
                        case FoodItemUpdateResultErrorCause.DUPLICATE_SYNONYMS_TO_ADD:
                            <div>
                                The synonyms list contains duplicates
                            </div>
                            break;
                        case FoodItemUpdateResultErrorCause.FOOD_ITEM_NAME_ALREADY_EXISTS:
                            <div>
                                A food item with this name already exists
                            </div>
                            break;
                        case FoodItemUpdateResultErrorCause.FOOD_ITEM_NAME_ALREADY_EXISTS_IN_SYNONYM:
                            <div>
                                This name is used as synonym for other food item
                            </div>
                            break;
                        case FoodItemUpdateResultErrorCause.SYNONYM_ALREADY_EXISTS:
                            <div>
                                This synonym already exists
                            </div>
                            break;
                        case FoodItemUpdateResultErrorCause.SYNONYM_ALREADY_EXISTS_AS_FOOD_ITEM_NAME:
                            <div>
                                This synonym already exists as a food name
                            </div>
                            break;
                    }
                </div>
            }
        </form>
    </div>
</div>

<div>
    @if (Model.ReturnUrl != null)
    {
        <a href="@Model.ReturnUrl">Back to List</a>
    }
    else
    {
        <a asp-action="Index">Back to List</a>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

    }
}
