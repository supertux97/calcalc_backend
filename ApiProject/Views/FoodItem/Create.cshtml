@model calcalc.ViewModels.FoodItemCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>FoodItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FoodItem.Name" class="control-label"></label>
                <input asp-for="FoodItem.Name" class="form-control" />
                <span asp-validation-for="FoodItem.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FoodItem.Calories" class="control-label"></label>
                <input asp-for="FoodItem.Calories" class="form-control" />
                <span asp-validation-for="FoodItem.Calories" class="text-danger"></span>
            </div>

            <p>Tip: Add synonyms that can be used in place of the name as well as different units that can be used to
                calculate,.</p>
            
                <hr />
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    

    </div>

    <div>
        <a asp-action="Index">Back to List</a>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
   
    }
